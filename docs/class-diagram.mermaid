classDiagram
  %% ===== 增量 1：阅读 streak =====
  class ReadStreakDay {
    +string date
    +boolean frozen
    +boolean makeup
    +number seconds
    +number sections
  }
  class ReadStreakFreeze {
    +number cards
    +number granted
    +string[] usedDates
  }
  class ReadMakeupRecord {
    +string month
    +number used
    +string[] dates
  }
  class ReadStreakStore {
    +Array~string|ReadStreakDay~ days
    +ReadStreakFreeze freeze
    +ReadMakeupRecord makeup
    +boolean migratedFromLearn
  }
  class ReadSession {
    +string date
    +number activeSeconds
    +Set~string~ sections
    +number lastTick
  }
  class ReadStreakService {
    +readReadStore() ReadStreakStore
    +beginReadSession(date) ReadSession
    +tickReadSession(s) ReadSession
    +markSectionSeen(s, kind) ReadSession
    +settleReadOnHide(s) SettleReadResult
    +settleReadStreakOnOpen() SettleResult
    +getReadStreak() number
    +isTodayRead() boolean
    +getReadFreezeCards() number
    +canMakeupRead() MakeupCheck
    +makeupReadMissed() MakeupResult
    +migrateFromLearnStreak() boolean
  }
  ReadStreakStore "1" *-- "0..*" ReadStreakDay
  ReadStreakStore "1" *-- "0..1" ReadStreakFreeze
  ReadStreakStore "1" *-- "0..1" ReadMakeupRecord
  ReadStreakService ..> ReadStreakStore : reads/writes
  ReadStreakService ..> ReadSession : manages

  %% ===== 增量 2：情报分组 =====
  class IntelRef {
    +string text
    +string source
  }
  class IntelGroup {
    +string title
    +string lead
    +IntelRef[] items
    +number[] citations
  }
  class IntelGroupsPayload {
    +IntelGroup[] groups
    +boolean degraded
    +object aiMeta
  }
  class LeadSegment {
    +string type
    +string text
    +number index
  }
  class IntelGroupsUtil {
    +normalizeIntelGroups(intel) IntelGroupsPayload
    +groupIntelLocally(items) IntelGroup[]
    +splitLeadSegments(lead) LeadSegment[]
  }
  IntelGroup "1" *-- "0..*" IntelRef
  IntelGroupsPayload "1" *-- "0..*" IntelGroup
  IntelGroupsUtil ..> IntelGroupsPayload
  IntelGroupsUtil ..> LeadSegment

  %% ===== 增量 3：习惯守护 =====
  class Habit {
    +string id
    +string title
    +string preferredStart
    +number durationMinutes
    +object window
    +boolean allowDayShift
    +boolean autoGuard
    +string eventId
    +string createdAt
  }
  class HabitGuardRecord {
    +string habitId
    +string date
    +string fromTime
    +string toTime
    +string blockedBy
    +boolean auto
    +string undoUntil
    +string createdAt
  }
  class HabitStore {
    +Habit[] habits
    +HabitGuardRecord[] records
    +number maxRecords
  }
  class HabitService {
    +readHabitStore() HabitStore
    +listHabits() Habit[]
    +upsertHabit(h) Habit
    +setHabitAutoGuard(id, on) Habit
    +removeHabit(id) void
    +isSlotInWindow(c, window) boolean
    +guardHabitsOnOpen(existing) GuardResult
    +listGuardRecords() HabitGuardRecord[]
    +undoHabitGuard(recordId) Promise
    +pushHabitNotice(r) void
  }
  class SlotCandidate {
    +string startTime
    +string endTime
    +string busyness
    +string reason
    +number score
    +number bufferMinutes
  }
  class PlanProposalRaw {
    +string title
    +string fromTime
    +string toTime
    +string endTime
    +string eventId
  }

  HabitStore "1" *-- "0..*" Habit
  HabitStore "1" *-- "0..*" HabitGuardRecord
  Habit *-- HabitGuardRecord : produced
  HabitService ..> HabitStore
  HabitService ..> SlotCandidate : reuses suggestSlotCandidates
  HabitService ..> PlanProposalRaw : emits for high-risk
